# Backend — variables de entorno (dev/staging/prod)
# Copiar a backend/.env (gitignored) y ajustar por ambiente.

# Base de datos PostgreSQL (local Docker o Neon)
DATABASE_URL=postgresql://postgres:password@localhost:5432/trastornadores

# Servidor
PORT=3000
NODE_ENV=development
# NODE_ENV=staging | production

# Firebase Admin (ruta al service account, NUNCA commitear)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Bootstrap admin: UIDs y/o emails separados por coma (solo estos pueden nacer ADMIN)
ADMIN_UIDS=mock-uid-123
ADMIN_EMAILS=admin@trastornadores.org

# CORS por ambiente
# - dev: se ignora (origin:true)
# - staging: lista o defaults dev
# - production: SOLO esta lista (vacia = denegar todo)
CORS_ORIGINS=https://app.trastornadores.org

# Swagger: solo prod lo apaga por defecto
# ENABLE_SWAGGER=true  # descomentar para forzar docs en prod
